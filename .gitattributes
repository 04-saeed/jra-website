# Normalize line endings for everyone (this repo's history is LF; Windows
# checkouts were drifting to CRLF on disk, which made every text file show
# as "modified" with no real content change).
* text=auto eol=lf

# Binary files: never touch line endings or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.pptx binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
